# Example local environment values. Replace every placeholder before running.
DB_URL=jdbc:postgresql://localhost:5432/employee_management_system
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-postgres-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
COOKIE_SECURE=false

# Exact browser origin; set to the deployed HTTPS origin in production.
APP_ORIGIN=http://localhost:8080
